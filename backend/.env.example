# Copy to .env (and optionally .env.local for per-machine overrides).
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: SQLite is used while DATABASE_URL is unset.
# To switch to Postgres: `docker compose up -d`, then uncomment DATABASE_URL.
POSTGRES_DB=skillwala
POSTGRES_USER=skillwala
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# DATABASE_URL=postgres://skillwala:change-me@localhost:5432/skillwala

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
AUTH_THROTTLE_RATE=10/min

# Uploaded dataset images are stored here.
# MEDIA_ROOT=/var/lib/skillwala/media
DATASET_MAX_ARCHIVE_MB=500
DATASET_MAX_UNCOMPRESSED_MB=2048
DATASET_MAX_FILES=20000
